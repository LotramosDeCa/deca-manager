/*
  # -- Prevenir clickjacking (no se puede meter tu app en un iframe ajeno)
  X-Frame-Options: DENY

  # -- Prevenir que el navegador adivine el tipo MIME (evita ataques de sniffing)
  X-Content-Type-Options: nosniff

  # -- Forzar HTTPS siempre (HSTS) — 1 año
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # -- Controlar qué información se envía como referrer
  Referrer-Policy: strict-origin-when-cross-origin

  # -- Deshabilitar APIs del navegador que no usas (cámara, micrófono, geolocalización, pago)
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

  # -- Content Security Policy — la más importante
  # Solo permite cargar recursos de fuentes confiables
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://dzotgifxgjfvpprjffow.supabase.co https://*.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

  # -- Prevenir ataques XSS en navegadores antiguos
  X-XSS-Protection: 1; mode=block
